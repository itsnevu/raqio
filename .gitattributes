# Simpan LF di repo untuk semua teks; hentikan peringatan CRLF di Windows.
* text=auto eol=lf
# skrip shell wajib LF (dijalankan bash di server dan Git Bash); CRLF membuat bash gagal dengan "$'\r'"
*.sh text eol=lf
*.caddy text eol=lf
known_hosts text eol=lf
*.png binary
*.jpg binary
*.svg text
*.ico binary
*.db binary
