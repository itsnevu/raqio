{
  "uid": "raqio-ops",
  "title": "Raqio operasional",
  "tags": ["raqio"],
  "timezone": "Asia/Jakarta",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    { "id": 1, "type": "stat", "title": "Uptime API", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [{ "expr": "raqio_uptime_seconds", "refId": "A" }] },
    { "id": 2, "type": "stat", "title": "Request sedang diproses", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "targets": [{ "expr": "raqio_http_inflight", "refId": "A" }] },
    { "id": 3, "type": "stat", "title": "Job antre", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] } } },
      "targets": [{ "expr": "sum(raqio_jobs{status=\"queued\"}) or vector(0)", "refId": "A" }] },
    { "id": 4, "type": "stat", "title": "Job berjalan", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "targets": [{ "expr": "sum(raqio_jobs{status=\"running\"}) or vector(0)", "refId": "A" }] },
    { "id": 5, "type": "stat", "title": "Umur antrean tertua", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 300 }, { "color": "red", "value": 900 }] } } },
      "targets": [{ "expr": "raqio_jobs_oldest_queued_seconds", "refId": "A" }] },
    { "id": 6, "type": "stat", "title": "Ditolak rate limit (laju/menit)", "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "targets": [{ "expr": "rate(raqio_rate_limited_total[5m]) * 60", "refId": "A" }] },

    { "id": 10, "type": "timeseries", "title": "Request per detik per kelas status", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [
        { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
        { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] } ] },
      "targets": [{ "expr": "sum by (class) (rate(raqio_http_requests_total[5m]))", "legendFormat": "{{class}}", "refId": "A" }] },
    { "id": 11, "type": "timeseries", "title": "Job per status", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "targets": [{ "expr": "raqio_jobs", "legendFormat": "{{status}}", "refId": "A" }] },

    { "id": 20, "type": "timeseries", "title": "Durasi job (p50 dan p90, 24 jam) per jenis", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "raqio_job_duration_seconds", "legendFormat": "{{kind}} p{{quantile}}", "refId": "A" }] },
    { "id": 21, "type": "timeseries", "title": "Job gagal (24 jam) per jenis", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [{ "expr": "raqio_jobs_failed_total", "legendFormat": "{{kind}}", "refId": "A" }] },

    { "id": 30, "type": "timeseries", "title": "Webhook outbox", "gridPos": { "x": 0, "y": 20, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "targets": [{ "expr": "raqio_webhook_outbox", "legendFormat": "{{state}}", "refId": "A" }] },
    { "id": 31, "type": "stat", "title": "Alert pantauan 24 jam", "gridPos": { "x": 8, "y": 20, "w": 4, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "targets": [{ "expr": "raqio_alerts_24h", "refId": "A" }] },
    { "id": 32, "type": "stat", "title": "Job asisten 24 jam", "gridPos": { "x": 12, "y": 20, "w": 4, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "targets": [{ "expr": "raqio_chat_jobs_24h", "refId": "A" }] },
    { "id": 33, "type": "timeseries", "title": "Laju 5xx (per menit)", "gridPos": { "x": 16, "y": 20, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "raqio-prom" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 4 }] } } },
      "targets": [{ "expr": "rate(raqio_http_requests_total{class=\"5xx\"}[5m]) * 60", "legendFormat": "5xx/menit", "refId": "A" }] }
  ]
}
