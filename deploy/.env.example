# Salin ke deploy/.env lalu isi. deploy/.env tidak boleh di-commit (.gitignore sudah mengecualikan .env).
# Nilai rahasia yang kosong sengaja membuat `docker compose config` dan `up` gagal.

DOMAIN=raqio.example.com

# Password Postgres (user raqio). Hasilkan:  openssl rand -hex 24
PG_PASSWORD=

# Rahasia tanda tangan sesi, dipakai api dan web, minimal 32 karakter acak. Hasilkan:  openssl rand -hex 32
# Mengganti nilai ini membuat semua sesi login keluar.
AUTH_SECRET=

# Asisten chat (OpenRouter). Kosong = asisten menjawab "belum dikonfigurasi". OPENROUTER_MODEL opsional.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CHAT_ENABLED=1
ALLOW_REGISTER=1
WORKER_REPLICAS=1

# Email transaksional (verifikasi, lupa password, undangan). Produksi wajib diisi; tanpa SMTP tautan hanya masuk log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=Raqio <no-reply@raqio.example.com>

# Pembayaran Xendit (kosong = mode manual)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Notifikasi Telegram untuk alert pantauan (opsional)
TELEGRAM_BOT_TOKEN=

# Token untuk GET /metrics (header Authorization: Bearer ...). Hasilkan:  openssl rand -hex 16
# Kosong = /metrics ditolak. Caddy juga memblok /metrics dari luar jaringan privat.
METRICS_TOKEN=

# Swagger UI di /docs dan /openapi.yaml. 0 di produksi.
DOCS=0

# Monitoring (profile `monitoring`): Grafana di 127.0.0.1:3001 (akses lewat SSH tunnel), Prometheus memakai METRICS_TOKEN.
GRAFANA_ADMIN_PASSWORD=
PROM_RETENTION=30d

# Proxy tepercaya untuk membaca X-Forwarded-For (CIDR, pisah koma). Kosong = jaringan privat (Caddy di compose).
# Di belakang CDN isi dengan CIDR CDN dan aktifkan trusted_proxies di deploy/Caddyfile.
TRUSTED_PROXIES=

# Alarm operasional (pengganti Sentry): panic, lonjakan 5xx, job gagal beruntun, webhook menyerah, DB putus.
# OPS_TELEGRAM_CHAT memakai TELEGRAM_BOT_TOKEN di atas. OPS_WEBHOOK_URL dikirim dengan HMAC OPS_WEBHOOK_SECRET.
OPS_TELEGRAM_CHAT=
OPS_WEBHOOK_URL=
OPS_WEBHOOK_SECRET=
OPS_5XX_THRESHOLD=20

# Jam (Asia/Jakarta) pengiriman ringkasan prospek jatuh tempo ke saluran notifikasi org
DIGEST_HOUR=8

# Mode tamu dan cache laporan
# GUEST_MAX_PER_HOUR : batas riset tamu per jam (global). Kosong = default di kode.
# MARKET_CACHE_DAYS  : laporan org lain untuk pasangan yang sama dipakai ulang selama N hari.
# SUGGEST_MIN_ORGS   : pasangan industri+wilayah muncul di /market/suggest hanya bila diriset minimal N org.
GUEST_MAX_PER_HOUR=
MARKET_CACHE_DAYS=7
# Sumber data selain scraping Google Maps (dipisah koma): overture (Overture Maps, gratis tanpa kunci), osm
# (OpenStreetMap), places_api (Google Places API resmi, butuh GOOGLE_PLACES_API_KEY), tomtom (butuh TOMTOM_API_KEY).
# "none" = hanya Maps. OVERTURE_RELEASE kosong = rilis terbaru dari katalog STAC Overture.
MARKET_SOURCES=overture,osm
OVERTURE_RELEASE=
GOOGLE_PLACES_API_KEY=
TOMTOM_API_KEY=
SUGGEST_MIN_ORGS=3

# Rate limit: per IP semua endpoint, dan per org untuk endpoint yang membuat job
RATE_LIMIT_PER_MINUTE=300
JOB_RATE_LIMIT_PER_MINUTE=10

# Backup (service backup, skrip deploy/backup.sh)
BACKUP_KEEP_DAYS=14
# Kunci publik age (age1...) untuk mengenkripsi backup. Buat pasangan kunci di mesin lain:
#   age-keygen -o raqio-backup.key   (baris "public key:" masuk ke sini; file .key JANGAN di VPS)
# Kosong = backup hanya gzip, tanpa enkripsi (ada peringatan di log backup).
BACKUP_AGE_RECIPIENT=
# Tujuan salinan offsite, mis. s3://bucket/raqio. Kosong = hanya volume lokal. Butuh AWS_* di bawah.
BACKUP_S3_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Untuk S3 kompatibel (MinIO, R2, Wasabi): AWS_ENDPOINT_URL=https://...
AWS_ENDPOINT_URL=
