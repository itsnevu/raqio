PORT=8080
DATABASE_URL=postgres://raqio:raqio@127.0.0.1:5433/raqio?sslmode=disable
# HARUS sama dengan AUTH_SECRET di apps/web
AUTH_SECRET=ganti-dengan-string-acak-panjang
# service Python legacy (fitur IG), hanya diakses dari API
SCRAPER_URL=http://127.0.0.1:8000
# 1 kalau di balik HTTPS
COOKIE_SECURE=0
# 0 untuk menutup pendaftaran publik (undangan saja)
ALLOW_REGISTER=1
# retensi laporan, mis. 2160h = 90 hari
RETENTION=2160h
# alamat frontend, dipakai di tautan email (verifikasi, reset, undangan)
APP_URL=http://localhost:3000
# email: kosongkan SMTP_HOST di dev, tautan dicatat di log API
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Raqio <no-reply@raqio.id>
# pembayaran Xendit; kosong = mode manual (pengelola set paket lewat DB)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# rate limit (per menit). Per IP untuk semua endpoint, per org untuk endpoint yang membuat job
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=60
JOB_RATE_LIMIT_PER_MINUTE=10
JOB_RATE_LIMIT_BURST=5
# koneksi Postgres maksimal per instance API
DB_MAX_CONNS=10
