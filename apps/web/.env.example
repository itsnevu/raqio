# salin jadi .env.local lalu isi

# alamat service Python (services/scraper/app.py)
BACKEND_URL=http://127.0.0.1:8000

# login (sementara satu akun dari env, nanti pindah ke backend Go)
AUTH_USER=admin
AUTH_PASS=ganti-password-ini
# string acak panjang untuk menandatangani cookie sesi, mis. hasil: openssl rand -hex 32
AUTH_SECRET=ganti-dengan-string-acak-panjang
# set 1 hanya kalau produksi jalan tanpa https
# AUTH_INSECURE_COOKIE=1
