# salin jadi .env.local lalu isi

# alamat Go API (apps/api)
API_URL=http://127.0.0.1:8080

# Tujuan tautan WA-Suite di pemilih produk setelah login
WASUITE_APP_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# HARUS sama dengan AUTH_SECRET di apps/api (dipakai memverifikasi cookie sesi), minimal 16 karakter acak
AUTH_SECRET=ganti-dengan-string-acak-panjang
# 1 = pengunjung tanpa sesi langsung masuk sebagai tamu (hanya untuk dev)
AUTO_GUEST=0
